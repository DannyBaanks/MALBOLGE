.CODE
LOW:
	Nop/Nop/Nop/Nop/MovD
	Jmp

HIGH:
	Nop/MovD
	Jmp

ROT:
	Rot/Nop
	Jmp

OUT:
	Out/Nop
	Jmp

HALT:
	Hlt

MOVED:
	MovD/Nop
	Jmp

.DATA {
loop:
	R_MOVED
ENTRY:
	LOW wrapped_low
	MOVED loop
wrapped_low:
	HIGH wrapped_high
	ROT '5'<<1 R_ROT
	OUT ?- R_OUT
	MOVED loop
wrapped_high:
	ROT 'X'<<1 R_ROT
	OUT ?- R_OUT
	HALT ?-
}
