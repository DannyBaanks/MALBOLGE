.CODE
N1:
	Nop/Nop/Nop/Nop/Nop/Nop/Nop/Nop/MovD
	Jmp

N2:
	Nop/Nop/Nop/Nop/Nop/Nop/Nop/Nop/MovD
	Jmp

N3:
	Nop/Nop/Nop/Nop/Nop/Nop/Nop/Nop/MovD
	Jmp

S:
	Nop/MovD
	Jmp

ROT:
	Rot/Nop
	Jmp

OUT:
	Out/Nop
	Jmp

HALT:
	Hlt

MOVED:
	MovD/Nop
	Jmp

MOV2:
	MovD/Nop
	Jmp

MOV3:
	MovD/Nop
	Jmp

.DATA {
	ENTRY:
	loop:
	R_MOVED
	N1 w1
	S st1
	MOVED loop
	w1:
	N2 w2
	S st1
	MOVED loop
	w2:
	N3 w3
	S st1
	MOVED loop
	w3:
	ROT 'Z'<<1 R_ROT
	OUT ?- R_OUT
	HALT ?-
	st1:
	R_MOV2
	MOV2 read_N1
	read_N1:
	N1 a1_9
	N1 a1_1
