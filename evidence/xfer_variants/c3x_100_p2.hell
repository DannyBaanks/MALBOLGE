	N2 a2_3
	N2 a2_4
	N2 a2_5
	N2 a2_6
	N2 a2_7
	N2 a2_8
	N2 a2_9
	a2_1:
	ROT '1'<<1 R_ROT
	OUT ?- R_OUT
