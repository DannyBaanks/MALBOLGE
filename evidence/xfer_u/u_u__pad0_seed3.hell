.CODE
TC:
	Rot/Nop
	Jmp

ROT:
	Rot/Nop
	Jmp

OUT:
	Out/Nop
	Jmp

HALT:
	Hlt

MOVED:
	MovD/Nop
	Jmp

.DATA {
	ENTRY:
	ROT 'X'<<1 R_ROT
	OUT ?- R_OUT
	U_TC ANCHOR
	s1:
	ROT '1'<<1 R_ROT
	OUT ?- R_OUT
	s2:
	ROT '2'<<1 R_ROT
	OUT ?- R_OUT
	s3:
	ROT '3'<<1 R_ROT
	OUT ?- R_OUT
	ANCHOR:
	C0
	B:
	ROT 'B'<<1 R_ROT
	OUT ?- R_OUT
	ROT 'D'<<1 R_ROT
	OUT ?- R_OUT
	C:
	ROT 'C'<<1 R_ROT
	OUT ?- R_OUT
	HALT ?-
}
